<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Theme Toggle -->
        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:tint="?attr/colorOnBackground"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Toggle Theme" />

        <!-- App Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="SudokuAI Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="56dp" />

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SudokuAI"
            android:textSize="36sp"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnBackground"
            app:layout_constraintTop_toBottomOf="@id/ivLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intelligent Puzzle Solving Engine"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.6"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

        <!-- Divider -->
        <View
            android:id="@+id/divider1"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="?attr/colorPrimary"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Quick Play Label -->
        <TextView
            android:id="@+id/tvQuickPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK PLAY"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textColor="?attr/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="28dp"
            android:layout_marginStart="28dp"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Easy Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnEasy"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/tvQuickPlay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnMedium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:background="#2E7D32"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Easy"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Medium Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnMedium"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/tvQuickPlay"
            app:layout_constraintStart_toEndOf="@id/btnEasy"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:background="#1565C0"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hard Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnHard"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/btnEasy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnExpert">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:background="#E65100"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hard"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Expert Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnExpert"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/btnMedium"
            app:layout_constraintStart_toEndOf="@id/btnHard"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:background="#880E4F"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expert"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Divider 2 -->
        <View
            android:id="@+id/divider2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:alpha="0.25"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnHard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Puzzle Library Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnPuzzles"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_puzzles"
                    android:tint="?attr/colorPrimary"
                    android:contentDescription="Puzzles" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Puzzle Library"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurface"
                    android:alpha="0.5"
                    android:contentDescription="Open" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AI Solver Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnAiSolver"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/btnPuzzles"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ai_brain"
                    android:tint="#FFFFFF"
                    android:contentDescription="AI Solver" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Solver"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter any puzzle — AI solves step by step"
                        android:textSize="11sp"
                        android:textColor="#CCFFFFFF" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#FFFFFF"
                    android:contentDescription="Open" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
