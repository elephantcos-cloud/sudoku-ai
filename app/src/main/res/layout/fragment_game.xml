<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorBackground"
        app:navigationIcon="@drawable/ic_arrow_left"
        app:navigationIconTint="?attr/colorOnBackground"
        app:titleTextColor="?attr/colorOnBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Timer + Difficulty Row -->
    <LinearLayout
        android:id="@+id/rowInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Difficulty badge -->
        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Easy"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorPrimary"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Timer -->
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_timer"
            android:tint="?attr/colorOnSurface"
            android:alpha="0.6"
            android:contentDescription="Timer"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Sudoku Board -->
    <com.shohan.sudokuai.view.SudokuBoardView
        android:id="@+id/sudokuBoard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/rowInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toTopOf="@id/rowActions" />

    <!-- Progress Bar (AI thinking) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/sudokuBoard"
        app:layout_constraintBottom_toBottomOf="@id/sudokuBoard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action Row: Undo, Erase, Check, Restart -->
    <LinearLayout
        android:id="@+id/rowActions"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/sudokuBoard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/numberPadContainer">

        <!-- Undo -->
        <LinearLayout
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_undo"
                android:tint="?attr/colorOnBackground"
                android:contentDescription="Undo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Undo"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Erase -->
        <LinearLayout
            android:id="@+id/btnErase"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_erase"
                android:tint="?attr/colorOnBackground"
                android:contentDescription="Erase" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Erase"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Check -->
        <LinearLayout
            android:id="@+id/btnCheck"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check"
                android:tint="?attr/colorOnBackground"
                android:contentDescription="Check" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Restart -->
        <LinearLayout
            android:id="@+id/btnRestart"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_restart"
                android:tint="?attr/colorOnBackground"
                android:contentDescription="Restart" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restart"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Hint -->
        <LinearLayout
            android:id="@+id/btnHint"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_hint"
                android:tint="?attr/colorOnBackground"
                android:contentDescription="Hint" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hint"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- AI Solve -->
        <LinearLayout
            android:id="@+id/btnAiSolve"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_ai_brain"
                android:tint="?attr/colorPrimary"
                android:contentDescription="AI Solve" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Solve"
                android:textSize="10sp"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Number Pad -->
    <LinearLayout
        android:id="@+id/numberPadContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/num1"
            style="@style/NumberPadButton"
            android:text="1" />
        <TextView android:id="@+id/num2"
            style="@style/NumberPadButton"
            android:text="2" />
        <TextView android:id="@+id/num3"
            style="@style/NumberPadButton"
            android:text="3" />
        <TextView android:id="@+id/num4"
            style="@style/NumberPadButton"
            android:text="4" />
        <TextView android:id="@+id/num5"
            style="@style/NumberPadButton"
            android:text="5" />
        <TextView android:id="@+id/num6"
            style="@style/NumberPadButton"
            android:text="6" />
        <TextView android:id="@+id/num7"
            style="@style/NumberPadButton"
            android:text="7" />
        <TextView android:id="@+id/num8"
            style="@style/NumberPadButton"
            android:text="8" />
        <TextView android:id="@+id/num9"
            style="@style/NumberPadButton"
            android:text="9" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
